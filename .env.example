# ===== 硅基流动 API 配置 =====
# 控制台：https://cloud.siliconflow.cn → 左侧「API 密钥」→ 新建 → 复制 sk- 开头的串
API_KEY=在这里填你的sk-开头的key
BASE_URL=https://api.siliconflow.cn/v1

# ===== 模型配置（写死型号，方便写简历和面试） =====
# 向量模型：bge-m3（中英文通用，支持长文本）
EMBED_MODEL=BAAI/bge-m3
# 生成模型：DeepSeek-chat
CHAT_MODEL=deepseek-ai/DeepSeek-V3

# ===== Rerank 重排 =====
# 重排模型：bge-reranker-v2-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 重排后端：api = 调硅基流动 /rerank 接口（推荐，不用装 torch）
#           local = 本地 sentence-transformers 的 CrossEncoder（需另装）
#           off   = 关闭重排，只做向量召回
RERANK_BACKEND=api

# ===== 要问答的文档（换成你任意 PDF 的路径即可） =====
DOC_PATH=F:/毕业设计/最终论文全套资料!!!!!!!!!!/2022091602012——徐茂棵_软件工程_基于YOLOv11的中草药智能识别与处方核对系统.pdf
